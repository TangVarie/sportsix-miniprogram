/* ---------- 能量胶：电解质（对比表） ---------- */
.pd-elec { padding: 77rpx 38rpx 46rpx; }
.pd-elec__sub { margin-bottom: 15rpx; }
.pd-elec__head { display: flex; gap: 23rpx; padding-bottom: 15rpx; border-bottom: 4rpx solid #010439; font-size: 25rpx; line-height: 38rpx; font-weight: 700; }
