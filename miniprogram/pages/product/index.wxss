.pd-hero__line--2 { clip-path: polygon(-0.5rpx 858.5rpx, 36.4rpx 880.4rpx, 73.3rpx 900.1rpx, 110.2rpx 917.3rpx, 147.1rpx 932.3rpx, 184rpx 944.9rpx, 220.9rpx 955.3rpx, 257.8rpx 963.2rpx, 294.8rpx 968.9rpx, 331.7rpx 972.2rpx, 368.6rpx 973.2rpx, 405.5rpx 971.9rpx, 442.4rpx 968.3rpx, 479.3rpx 962.3rpx, 516.3rpx 954rpx, 553.2rpx 943.3rpx, 590.1rpx 930.4rpx, 627rpx 915.1rpx, 663.9rpx 897.5rpx, 700.8rpx 877.6rpx, 737.7rpx 855.3rpx, 774.6rpx 830.7rpx, 811.5rpx 803.8rpx, 848.4rpx 774.6rpx, 885.3rpx 743rpx, 884rpx 741.6rpx, 847.1rpx 773.1rpx, 810.3rpx 802.3rpx, 773.5rpx 829.1rpx, 736.7rpx 853.7rpx, 699.8rpx 875.9rpx, 663rpx 895.8rpx, 626.2rpx 913.3rpx, 589.4rpx 928.6rpx, 552.6rpx 941.5rpx, 515.8rpx 952.1rpx, 479rpx 960.4rpx, 442.2rpx 966.4rpx, 405.4rpx 970rpx, 368.6rpx 971.3rpx, 331.8rpx 970.3rpx, 295rpx 967rpx, 258.2rpx 961.4rpx, 221.4rpx 953.4rpx, 184.6rpx 943.1rpx, 147.8rpx 930.5rpx, 111rpx 915.6rpx, 74.1rpx 898.3rpx, 37.3rpx 878.8rpx, 0.5rpx 856.9rpx); }
