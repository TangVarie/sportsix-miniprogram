.pd-quad {
  display: flex; flex-direction: column; justify-content: space-between; box-sizing: border-box;
  width: 327rpx; height: 185rpx; padding: 27rpx; border-radius: 23rpx; background: #F5F5F5;
}
.pd-quad__title { font-size: 33rpx; line-height: 46rpx; font-weight: 900; color: #061A70; }
.pd-quad__body { font-size: 23rpx; line-height: 35rpx; color: #5E6170; }

/* ---------- 能量胶PRO：食用指南 ---------- */
.pd-guide { padding: 8rpx 38rpx 69rpx; color: #FFFFFF; }
.pd-steps { position: relative; display: flex; flex-direction: column; margin-top: 23rpx; }
.pd-steps__line { position: absolute; left: 19rpx; top: 58rpx; bottom: 58rpx; width: 8rpx; background: #C2E541; }
.pd-step { position: relative; display: flex; align-items: center; gap: 27rpx; height: 123rpx; }
.pd-step__dot { position: relative; }
.pd-step__when { flex-shrink: 0; width: 177rpx; font-size: 29rpx; line-height: 42rpx; font-weight: 900; }
.pd-step__card { flex: 1; display: flex; align-items: center; justify-content: space-between; height: 92rpx; padding: 0 27rpx; border-radius: 19rpx; background: #061A70; }
.pd-step__what { font-size: 29rpx; font-weight: 900; }
.pd-step__qty { font-size: 23rpx; font-weight: 700; color: #C2E541; }
.pd-guide__note { margin-top: 19rpx; font-size: 25rpx; line-height: 40rpx; color: #C9CEE8; }

/* ---------- 能量胶PRO：Q&A ---------- */
.pd-qa { padding: 77rpx 38rpx 54rpx; }
.pd-qa__list { display: flex; flex-direction: column; gap: 19rpx; margin-top: 23rpx; }
.pd-qa__item { border-radius: 27rpx; background: #F5F5F5; overflow: hidden; }
.pd-qa__head { display: flex; align-items: center; gap: 27rpx; box-sizing: border-box; min-height: 123rpx; padding: 27rpx 31rpx; }
.pd-qa__n { flex-shrink: 0; width: 65rpx; font-size: 54rpx; line-height: 58rpx; color: #061A70; }
.pd-qa__q { flex: 1; font-size: 29rpx; line-height: 42rpx; font-weight: 700; color: #010439; }
/* 图标是向右的箭头：转 90° 朝下，展开时朝上 */
.pd-qa__arrow { flex-shrink: 0; display: block; width: 35rpx; height: 35rpx; transform: rotate(90deg); transition: transform .25s ease; }
.pd-qa__arrow--open { transform: rotate(270deg); }
.pd-qa__a { padding: 0 31rpx 31rpx 123rpx; font-size: 25rpx; line-height: 40rpx; color: #14141E; animation: sxRise .3s ease-out both; }

/* ---------- 营养成分表 ---------- */
.pd-nutri { padding: 23rpx 38rpx 54rpx; }
.pd-nutri__head { display: flex; align-items: center; justify-content: space-between; height: 92rpx; padding: 0 31rpx; background: #061A70; color: #FFFFFF; }
.pd-nutri__title { font-size: 31rpx; font-weight: 900; }
.pd-nutri__per { font-size: 23rpx; }
.pd-nutri__body { padding: 0 31rpx; border: 1px solid #E6E6E7; border-top: 0; }
.pd-nutri__row { display: flex; align-items: center; justify-content: space-between; height: 85rpx; font-size: 27rpx; }
.pd-nutri__row--line { border-bottom: 1px solid #E6E6E7; }
.pd-nutri__k { color: #5E6170; }
.pd-nutri__v { font-weight: 700; }
.pd-nutri__foot { margin-top: 19rpx; }

/* ---------- 成为会员 ---------- */
.pd-join { padding: 0 38rpx 54rpx; }
.pd-join__btn {
  display: flex; align-items: center; justify-content: center;
  height: 100rpx; border-radius: 50rpx; background: #C2E541; color: #010439; font-size: 31rpx; font-weight: 900;
}
