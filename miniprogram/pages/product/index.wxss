.pd-cols { display: flex; align-items: flex-end; gap: 23rpx; height: 454rpx; border-bottom: 4rpx solid #010439; }
.pd-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 12rpx; }
.pd-col__value { font-size: 42rpx; line-height: 44rpx; color: #5E6170; }
.pd-col__bar { width: 108rpx; background: #C8CAD3; }
.pd-col__label { height: 69rpx; font-size: 23rpx; line-height: 35rpx; text-align: center; color: #5E6170; }
.pd-col--on .pd-col__value { font-size: 50rpx; line-height: 52rpx; color: #061A70; }
.pd-col--on .pd-col__bar { background: #C2E541; }
.pd-col--on .pd-col__label { font-weight: 700; color: #010439; }
.pd-density__foot { margin-top: 19rpx; }

/* ---------- 能量胶：咖啡因（横条） ---------- */
.pd-caffeine { padding: 69rpx 38rpx 62rpx; background: #F5F5F5; }
