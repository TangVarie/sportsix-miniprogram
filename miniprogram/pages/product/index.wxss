/* 光晕：同一条弧线模糊 16px、60% 透明度。和其他页面的弧线一样保持静止。 */
.pd-hero__glow { opacity: .6; filter: blur(31rpx); }

/* 能量胶PRO 首屏：镂空的 PRO 字样和弧线文件 */
.pd-hero__ghost {
  position: absolute; left: 288rpx; top: calc(550rpx + var(--sx-safe-top));
  font-size: 365rpx; line-height: 365rpx; white-space: nowrap;
  color: transparent; -webkit-text-stroke: 4rpx #2F3A86;
}
.pd-hero__arc-img { position: absolute; left: 0; top: var(--sx-safe-top); width: 750rpx; height: 962rpx; }

/* 包装 */
.pd-hero__packs { position: absolute; left: 0; top: var(--sx-safe-top); width: 0; height: 0; }
.pd-hero__pack { position: absolute; }
.pd-hero__pack--back { left: 504rpx; top: 288rpx; }
.pd-hero__pack--front { left: 346rpx; top: 231rpx; }
.pd-hero__pack--pro { left: 415rpx; top: calc(185rpx + var(--sx-safe-top)); }
.pd-hero__img { display: block; transform-origin: 50% 60%; }
.pd-hero__img--back { height: 577rpx; transform: rotate(24deg); }
.pd-hero__img--front { height: 635rpx; transform: rotate(10deg); }
.pd-hero__img--pro { height: 673rpx; transform: rotate(12deg); }

.pd-back {
  position: absolute; left: 23rpx; top: calc(15rpx + var(--sx-safe-top));
  display: flex; align-items: center; gap: 8rpx;
  height: 85rpx; padding: 0 15rpx; font-size: 27rpx; font-weight: 500;
}
.pd-back__icon { display: block; width: 38rpx; height: 38rpx; }

.pd-hero__text {
  position: absolute; left: 38rpx; top: calc(131rpx + var(--sx-safe-top)); width: 365rpx;
  display: flex; flex-direction: column; align-items: flex-start; gap: 19rpx;
}
.pd-hero__text--pro { width: 404rpx; }
.pd-hero__tag { display: inline-block; padding: 8rpx 31rpx; background: #C2E541; color: #010439; font-size: 23rpx; line-height: 35rpx; font-weight: 700; }
.pd-hero__h1 { margin-top: 8rpx; font-size: 77rpx; line-height: 92rpx; font-weight: 900; }
.pd-hero__en { color: #C2E541; }
.pd-hero__lead { font-size: 29rpx; line-height: 46rpx; font-weight: 500; }

/* 口味切换（能量胶） */
.pd-flavors { margin-top: 12rpx; display: flex; flex-direction: column; align-items: flex-start; gap: 15rpx; }
.pd-flavor {
  display: flex; align-items: center; box-sizing: border-box;
  height: 85rpx; padding: 0 31rpx; border-radius: 42rpx; border: 1px solid #FFFFFF;
  font-size: 25rpx; font-weight: 700; color: #FFFFFF;
}
.pd-flavor--on { background: #FFFFFF; color: #010439; }

/* 特点标签（能量胶PRO） */
.pd-chips { margin-top: 12rpx; display: flex; flex-wrap: wrap; gap: 12rpx; width: 365rpx; }
.pd-chip {
  display: flex; align-items: center;
  height: 54rpx; padding: 0 23rpx; border-radius: 27rpx;
  background: #FFFFFF; color: #010439; font-size: 23rpx; font-weight: 700;
}
.pd-chip--line { box-sizing: border-box; border: 1px solid #FFFFFF; background: transparent; color: #FFFFFF; font-weight: 400; }

/* ---------- 四个数字 ---------- */
.pd-facts { display: flex; flex-wrap: wrap; justify-content: space-between; row-gap: 19rpx; padding: 38rpx 38rpx 15rpx; }
.pd-fact {
  display: flex; flex-direction: column; justify-content: space-between; box-sizing: border-box;
  width: 327rpx; height: 162rpx; padding: 23rpx 27rpx; border-radius: 23rpx; background: #F5F5F5;
}
.pd-fact__num { display: flex; align-items: baseline; gap: 8rpx; color: #061A70; }
.pd-fact__value { font-size: 65rpx; line-height: 67rpx; }
.pd-fact__unit { font-size: 29rpx; line-height: 1.2; }
.pd-fact__label { font-size: 23rpx; line-height: 35rpx; color: #5E6170; }

/* ---------- 各分区共用 ---------- */
.pd-sec { display: flex; flex-direction: column; gap: 12rpx; }
.pd-eyebrow { color: #061A70; }
.pd-eyebrow--lime { color: #C2E541; }
.pd-h2 { font-size: 42rpx; line-height: 58rpx; font-weight: 900; color: #010439; }
.pd-h2--light { color: #FFFFFF; }
.pd-sub { font-size: 27rpx; line-height: 42rpx; color: #5E6170; }
.pd-foot { font-size: 21rpx; line-height: 33rpx; color: #5E6170; }
.pd-foot--navy { color: #9AA1C8; }
/* 时间顺序的圆点：深蓝实心、黄绿描边 */
.pd-dot { flex-shrink: 0; box-sizing: border-box; width: 46rpx; height: 46rpx; border-radius: 23rpx; background: #010439; border: 6rpx solid #C2E541; }

/* 雷达图：能量胶的 5 SOURCES、能量胶PRO 的 6 INGREDIENTS */
.pd-sources { padding: 69rpx 38rpx 38rpx; }
.pd-ingredients { padding: 54rpx 38rpx 46rpx; }
.pd-sources__sub { margin-bottom: 12rpx; }
.pd-radar { position: relative; width: 673rpx; }
.pd-radar--5 { height: 558rpx; }
.pd-radar--6 { height: 577rpx; }
.pd-radar__chart { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.pd-radar__pack { position: absolute; left: 292rpx; }
.pd-radar__pack--5 { top: 146rpx; height: 288rpx; }
.pd-radar__pack--6 { top: 142rpx; height: 292rpx; }

/* ---------- 能量胶：高配比（柱形图） ---------- */
.pd-density { padding: 77rpx 38rpx 54rpx; }
.pd-density__sub { margin-bottom: 8rpx; }
.pd-density__hl { align-self: flex-start; display: flex; align-items: baseline; gap: 15rpx; margin: 12rpx 0 4rpx; }
.pd-density__hl-label { font-size: 25rpx; line-height: 38rpx; font-weight: 700; color: #010439; }
