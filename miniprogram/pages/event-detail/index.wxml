<view wx:if="{{event}}" class="page ed-page" style="--sx-safe-top: {{safeTop}}px">
  <view class="ed-header sx-in">
    <view class="ed-header__photo sx-photo"><image class="sx-photo__img ed-header__img sx-img-fade {{loaded.head ? '' : 'sx-img-wait'}}" data-img="head" bindload="onImgLoad" binderror="onImgLoad" src="{{event.image}}" mode="aspectFill" /></view>
    <image wx:if="{{event.graphic}}" class="ed-header__ridge sx-draw" src="{{event.graphic}}" />
    <view class="ed-back" bindtap="onBack" aria-role="button" aria-label="{{clientCopy.back}}">
      <image class="ed-back__icon" src="/assets/icons/back-white.svg" />
      <text>活动</text>
    </view>
    <view class="ed-header__title">
      <view class="ed-header__tags">
        <text wx:if="{{event.tag}}" class="ed-tag sx-slant">{{event.tag}}</text>
        <text class="ed-type">{{event.type}}</text>
      </view>
      <view class="ed-header__h1">{{event.title}}</view>
    </view>
    <view class="ed-facts">
      <view wx:for="{{headFields}}" wx:key="k" class="ed-fact {{index > 0 ? 'ed-fact--split' : ''}}">
        <text class="ed-fact__k">{{item.k}}</text>
        <text class="ed-fact__v">{{item.v}}</text>
      </view>
    </view>
  </view>

  <view class="ed-body">
    <view wx:if="{{stale}}" class="ed-status">
      <text>{{clientCopy.stale}}</text>
      <view class="ed-status__retry" bindtap="onRetry" aria-role="button">{{clientCopy.retry}}</view>
    </view>
    <view class="ed-rows">
      <view wx:for="{{rowFields}}" wx:key="k" class="ed-row {{index < rowFields.length - 1 ? 'ed-row--line' : ''}}">
        <text class="ed-row__k">{{item.k}}</text>
        <text class="ed-row__v">{{item.v}}</text>
      </view>
    </view>

    <view wx:if="{{detail.memberBanner}}" class="ed-member">
      <image class="ed-member__icon" src="/assets/icons/flag-navy.svg" />
      <view class="ed-member__text">
        <text class="ed-member__title">{{detail.memberBanner.title}}</text>
        <text class="ed-member__body">{{detail.memberBanner.body}}</text>
      </view>
    </view>

    <view wx:if="{{detail.about.body}}" class="ed-about">
      <text class="sx-eyebrow ed-about__eyebrow">{{detail.about.eyebrow}}</text>
      <view class="ed-about__title">{{detail.about.title}}</view>
      <view class="ed-about__body">{{detail.about.body}}</view>
    </view>

    <!-- 报名须知：要用多少积分、报名后不能自行取消、有事找谁（设计稿里没有，后加的） -->
    <view wx:if="{{note}}" class="ed-note">
      <text class="ed-note__title">{{note.title}}</text>
      <text wx:for="{{note.lines}}" wx:key="*this" class="ed-note__line">{{item}}</text>
      <view wx:if="{{note.contact}}" class="ed-note__contact">
        <text class="ed-note__k">{{note.contactLabel}}</text>
        <text class="ed-note__v" user-select="{{true}}">{{note.contact}}</text>
      </view>
    </view>

    <view wx:if="{{groupReady}}" class="ed-group">
      <view class="ed-group__icon"><image class="ed-group__icon-img" src="/assets/icons/group-lime.svg" /></view>
      <view class="ed-group__text">
        <text class="ed-group__title">{{detail.group.title}}</text>
        <text class="ed-group__body">{{detail.group.body}}</text>
      </view>
      <view class="ed-group__btn sx-pressable" hover-class="sx-press" bindtap="onGroup">{{detail.group.button}}</view>
    </view>
  </view>

  <view class="ed-bar">
    <view class="ed-bar__hint">{{state.key === 'not_open' ? detail.reminderHint : state.readOnly ? state.label : signed ? signedText : state.label}}</view>
    <view class="ed-bar__btns">
      <view wx:if="{{state.canRemind || reminded}}" class="ed-btn ed-btn--ghost sx-pressable {{reminded ? 'ed-btn--done' : ''}}" hover-class="sx-press" bindtap="onRemind" aria-role="button" aria-disabled="{{!state.canRemind}}">
        <image class="ed-btn__icon" src="/assets/icons/bell-{{reminded ? 'grey' : 'navy'}}.svg" />
        <text>{{reminded ? remindedText : detail.buttons[0]}}</text>
      </view>
      <view class="ed-btn ed-btn--primary sx-pressable {{!state.canSignup ? 'ed-btn--done' : ''}}" hover-class="{{state.canSignup ? 'sx-press' : 'none'}}" bindtap="onSignup" aria-role="button" aria-disabled="{{!state.canSignup}}">{{state.signupLabel}}</view>
    </view>
  </view>
</view>

<view wx:else class="page ed-page" style="--sx-safe-top: {{safeTop}}px">
  <view class="ed-header ed-state-head sx-grid-bg">
    <view class="ed-back" bindtap="onBack" aria-role="button" aria-label="{{clientCopy.back}}">
      <image class="ed-back__icon" src="/assets/icons/back-white.svg" />
      <text>活动</text>
    </view>
  </view>
  <view class="ed-status ed-status--block">
    <view wx:if="{{loading}}" class="ed-state-skeleton sx-skeleton" aria-label="{{clientCopy.loading}}"></view>
    <block wx:else>
      <text>{{loadError ? clientCopy.loadFailed : clientCopy.eventUnavailable}}</text>
      <view wx:if="{{loadError}}" class="ed-status__retry" bindtap="onRetry" aria-role="button">{{clientCopy.retry}}</view>
      <view class="ed-status__retry" bindtap="onEvents" aria-role="button">{{clientCopy.backToEvents}}</view>
    </block>
  </view>
</view>
