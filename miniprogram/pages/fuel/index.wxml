<!--
  分段选择：选中为深蓝底白字。field 是 input 的字段名，value 是当前值，on 是当前值的序号，cols 是一行几个。
  选项比 cols 多时自动排成多行（项目是六个、一行三个）。
  三层叠在一起：最下面每个选项一块白底，中间一块深蓝底随选中项滑动（横向按列、纵向按行），最上面是可点的文字。
-->
<template name="fuel-seg">
  <view class="fuel-seg">
    <view class="fuel-seg__track fuel-seg--{{cols}}"><view wx:for="{{options}}" wx:key="label" class="fuel-seg__slot"></view></view>
    <view class="fuel-seg__ind fuel-seg__ind--{{cols}}" style="transform: translate(calc({{on % cols}} * (100% + 12rpx)), {{(on - on % cols) / cols * 97}}rpx)"></view>
    <view class="fuel-seg__btns fuel-seg--{{cols}}">
      <view wx:for="{{options}}" wx:key="label" class="fuel-seg__btn sx-pressable {{item.value === value ? 'fuel-seg__btn--on' : ''}}" hover-class="sx-press" data-field="{{field}}" data-index="{{index}}" bindtap="onPick">{{item.label}}</view>
    </view>
  </view>
</template>

<view class="page sx-tab-page" style="--sx-safe-top: {{safeTop}}px">
  <view class="fuel-header sx-in">
    <view class="fuel-header__photo sx-photo"><image class="sx-photo__img fuel-header__img sx-img-fade {{loaded.head ? '' : 'sx-img-wait'}}" data-img="head" bindload="onImgLoad" binderror="onImgLoad" src="{{photo}}" mode="aspectFill" /></view>
    <view class="fuel-header__shade"></view>
    <view class="fuel-header__text">
      <text class="sx-eyebrow fuel-header__eyebrow">FUEL PLAN</text>
      <view class="fuel-header__h1 sx-rise" style="animation-delay: .05s">分段补给计算</view>
      <view class="fuel-header__desc sx-rise" style="animation-delay: .2s">按项目、时长、体重和咖啡因，排出整场什么时候吃哪一支。</view>
    </view>
  </view>

  <!-- 01 这场运动 -->
  <view class="fuel-card">
    <view class="fuel-card__head"><text class="fuel-card__no sx-num">01</text><text class="fuel-card__title">这场运动</text></view>
    <!-- 六个项目排两行三列 -->
    <view class="fuel-row fuel-row--tall">
      <text class="fuel-row__label">项目</text>
      <view class="fuel-row__main"><template is="fuel-seg" data="{{field: 'sport', options: sports, value: input.sport, on: on.sport, cols: 3}}" /></view>
    </view>
    <!-- 强度：从轻到重三档，下面一句话说明选中的这一档。徒步、登山、滑雪不分强度，这一行不显示 -->
    <view wx:if="{{showScene}}" class="fuel-row fuel-row--tall fuel-row--top">
      <text class="fuel-row__label fuel-row__label--seg">强度</text>
      <view class="fuel-row__main">
        <template is="fuel-seg" data="{{field: 'scene', options: scenes, value: input.scene, on: on.scene, cols: 3}}" />
        <view class="fuel-row__hint">{{sceneHint}}</view>
      </view>
    </view>
    <view class="fuel-row fuel-row--last">
      <text class="fuel-row__label">预计时长</text>
      <view class="fuel-row__main">
        <!-- 减的两个按钮并成一个白色胶囊，加的两个并成一个深蓝胶囊，时间在中间：比五样东西排一排松快 -->
        <view class="fuel-step fuel-step--time">
          <view class="fuel-pill">
            <view class="fuel-pill__btn sx-num sx-pressable" hover-class="sx-press" data-field="minutes" data-delta="-60" bindtap="onStep">-1h</view>
            <view class="fuel-pill__btn fuel-pill__btn--next sx-num sx-pressable" hover-class="sx-press" data-field="minutes" data-delta="-15" bindtap="onStep">-15</view>
          </view>
          <!-- 点时间弹出选择器，直接选几小时几分；长距离的不用一下一下点加号 -->
          <picker class="fuel-step__pick" mode="multiSelector" range="{{timeRange}}" value="{{timeValue}}" bindchange="onTimePick">
            <text class="fuel-step__time fuel-step__time--pick sx-num">{{durationLabel}}</text>
          </picker>
          <view class="fuel-pill fuel-pill--plus">
            <view class="fuel-pill__btn sx-num sx-pressable" hover-class="sx-press" data-field="minutes" data-delta="15" bindtap="onStep">+15</view>
            <view class="fuel-pill__btn fuel-pill__btn--next sx-num sx-pressable" hover-class="sx-press" data-field="minutes" data-delta="60" bindtap="onStep">+1h</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 02 你的情况 -->
  <view class="fuel-card">
    <view class="fuel-card__head"><text class="fuel-card__no sx-num">02</text><text class="fuel-card__title">你的情况</text></view>
    <view class="fuel-row">
      <text class="fuel-row__label">体重</text>
      <view class="fuel-row__main">
        <view class="fuel-step">
          <view class="fuel-step__btn sx-num sx-pressable" hover-class="sx-press" data-field="kg" data-delta="-5" bindtap="onStep">-5</view>
          <view class="fuel-step__kg"><text class="fuel-step__value sx-num">{{input.kg}}</text><text class="fuel-step__unit">kg</text></view>
          <view class="fuel-step__btn fuel-step__btn--plus sx-num sx-pressable" hover-class="sx-press" data-field="kg" data-delta="5" bindtap="onStep">+5</view>
        </view>
      </view>
    </view>
    <view class="fuel-row">
      <text class="fuel-row__label">咖啡因</text>
      <view class="fuel-row__main"><template is="fuel-seg" data="{{field: 'caffeineSensitive', options: caffeines, value: input.caffeineSensitive, on: on.caffeineSensitive, cols: 2}}" /></view>
    </view>
    <view class="fuel-row fuel-row--last">
      <text class="fuel-row__label">用胶经验</text>
      <view class="fuel-row__main"><template is="fuel-seg" data="{{field: 'firstTime', options: experiences, value: input.firstTime, on: on.firstTime, cols: 2}}" /></view>
    </view>
  </view>

  <!-- 03 当天 -->
  <view class="fuel-card">
    <view class="fuel-card__head"><text class="fuel-card__no sx-num">03</text><text class="fuel-card__title">当天</text></view>
    <view class="fuel-row">
      <text class="fuel-row__label">出发时间</text>
      <view class="fuel-row__main"><template is="fuel-seg" data="{{field: 'start', options: starts, value: input.start, on: on.start, cols: 3}}" /></view>
    </view>
    <view class="fuel-row fuel-row--last">
      <text class="fuel-row__label">天气</text>
      <view class="fuel-row__main"><template is="fuel-seg" data="{{field: 'weather', options: weathers, value: input.weather, on: on.weather, cols: 4}}" /></view>
    </view>
  </view>

  <!-- 结果 -->
  <view class="fuel-result sx-grid-bg sx-in">
    <block wx:if="{{plan.total > 0}}">
      <view class="fuel-result__top">
        <view class="fuel-result__count">
          <text class="fuel-result__word">这场带</text>
          <text wx:for="{{[plan.total]}}" wx:key="*this" class="fuel-result__total fuel-roll sx-num">{{item}}</text>
          <text class="fuel-result__word">支</text>
        </view>
        <view class="fuel-legend">
          <view class="fuel-legend__item"><view class="fuel-legend__mark fuel-legend__mark--gel"></view><text>能量胶BASIC × {{plan.gelCount}}</text></view>
          <view class="fuel-legend__item"><view class="fuel-legend__mark fuel-legend__mark--pro"></view><text>能量胶PRO × {{plan.proCount}}</text></view>
        </view>
      </view>

      <view class="fuel-stats">
        <view class="fuel-stat">
          <text class="fuel-stat__label">总碳水</text>
          <view class="fuel-stat__value"><text wx:for="{{[plan.totalCarb]}}" wx:key="*this" class="fuel-stat__num fuel-roll sx-num">{{item}}</text><text class="fuel-stat__unit">g</text></view>
        </view>
        <view class="fuel-stat fuel-stat--next">
          <text class="fuel-stat__label">咖啡因</text>
          <view class="fuel-stat__value"><text wx:for="{{[plan.caffeineMg]}}" wx:key="*this" class="fuel-stat__num fuel-roll sx-num">{{item}}</text><text class="fuel-stat__unit">mg</text></view>
        </view>
        <view class="fuel-stat fuel-stat--next">
          <text class="fuel-stat__label">能量</text>
          <view class="fuel-stat__value"><text wx:for="{{[plan.kcal]}}" wx:key="*this" class="fuel-stat__num fuel-roll sx-num">{{item}}</text><text class="fuel-stat__unit">千卡</text></view>
        </view>
      </view>

      <!-- 没加入会员：只看到带几支，时间表加入后才有 -->
      <view wx:if="{{!member}}" class="fuel-lock">
        <text class="fuel-lock__title">{{lock.title}}</text>
        <text class="fuel-lock__body">{{lock.body}}</text>
        <view class="fuel-lock__btn sx-pressable" hover-class="sx-press" bindtap="onJoin">{{lock.button}}</view>
      </view>

      <view wx:if="{{member && segmented}}" class="fuel-stages">
        <view class="fuel-stages__head"><text>{{ui.stages}}</text><text class="fuel-stages__count">{{stageCount}}</text></view>
        <text class="fuel-stages__hint">{{ui.stageHint}}</text>
        <scroll-view class="fuel-stages__scroll" scroll-x>
          <view class="fuel-stages__tabs">
            <view wx:for="{{stages}}" wx:key="index" class="fuel-stages__tab {{stageIndex === item.index ? 'fuel-stages__tab--on' : ''}}" data-index="{{item.index}}" bindtap="onStage">{{item.label}}</view>
          </view>
        </scroll-view>
      </view>

      <!-- 超过六小时仅画当前段的时间轴，所有格子保留出发后的绝对时刻。 -->
      <view wx:if="{{member}}" class="fuel-line {{stageIndex > 0 ? 'fuel-line--stage' : ''}}">
        <view class="fuel-line__track"></view>
        <view wx:for="{{stageItems}}" wx:key="id" class="fuel-line__dot sx-pop {{item.gel ? 'fuel-line__dot--gel' : ''}} {{active === index ? 'fuel-line__dot--active' : ''}}" style="left: {{item.position}}%"></view>
        <text class="fuel-line__start">{{stageStart}}</text>
        <text class="fuel-line__end">{{stageEnd}}</text>
      </view>

      <view wx:if="{{member}}" class="fuel-cells">
        <view wx:for="{{stageItems}}" wx:key="id" class="fuel-cell sx-pop {{item.gel ? 'fuel-cell--gel' : ''}} {{active === index ? 'fuel-cell--active' : ''}}" data-index="{{index}}" bindtap="onFocus">
          <text class="fuel-cell__time">{{item.label}}</text>
          <text class="fuel-cell__name">{{item.productName}}</text>
        </view>
      </view>

      <view wx:if="{{member}}" class="fuel-result__note">时间为出发后的时刻。两款都不需要配水。</view>
      <view wx:if="{{member && plan.days > 1}}" class="fuel-result__note">{{ui.fixedDay}}</view>
      <view wx:if="{{member && restoredSnapshot}}" class="fuel-result__note">{{ui.savedSnapshot}}</view>
    </block>

    <!-- 0 支 -->
    <view wx:else class="fuel-none">
      <text class="fuel-none__zero sx-num">0</text>
      <text class="fuel-none__title">这次不用带胶</text>
    </view>
  </view>

  <!-- 为什么这样排：句子全部来自 planFuel 的 reasons -->
  <view wx:if="{{member}}" class="fuel-why">
    <view class="fuel-why__title">为什么这样排</view>
    <view wx:for="{{plan.reasons}}" wx:key="*this" class="fuel-why__item">
      <view class="sx-check fuel-why__check"></view>
      <text class="fuel-why__text">{{item}}</text>
    </view>
  </view>

  <view class="fuel-actions">
    <view class="fuel-actions__save sx-pressable {{saving ? 'fuel-actions__save--busy' : ''}}" hover-class="sx-press" bindtap="onSave">{{saving ? ui.saving : ui.save}}</view>
    <view class="fuel-actions__more sx-pressable" hover-class="sx-press" bindtap="onProducts">看两款胶</view>
  </view>
  <view class="fuel-foot">结果按产品成分和通行的运动营养建议计算，供参考。可根据个人体能、出汗量微调，新的补给方式先在训练里试。</view>
</view>
