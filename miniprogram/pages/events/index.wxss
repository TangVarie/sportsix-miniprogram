/* 数值取自 design/html/05-events-*.html，px × 750 ÷ 390 */

/* 头部：设计高 176px，上方让出状态栏 */
.ev-header { position: relative; height: calc(338rpx + var(--sx-safe-top)); overflow: hidden; color: #FFFFFF; }
.ev-header__arc { position: absolute; left: 0; bottom: 0; width: 750rpx; height: 338rpx; }
.ev-header__title { position: absolute; left: 38rpx; top: calc(54rpx + var(--sx-safe-top)); display: flex; flex-direction: column; gap: 8rpx; }
.ev-header__eyebrow { color: #C2E541; }
.ev-header__h1 { font-size: 58rpx; line-height: 77rpx; font-weight: 900; }
.ev-tabs { position: absolute; left: 38rpx; bottom: 31rpx; display: flex; gap: 15rpx; }
.ev-tab {
  display: flex; align-items: center; box-sizing: border-box;
  height: 85rpx; padding: 0 38rpx; border-radius: 42rpx; border: 1px solid #FFFFFF;
  font-size: 27rpx; font-weight: 700; color: #FFFFFF;
}
.ev-tab--on { background: #FFFFFF; color: #010439; }

.ev-list { padding: 38rpx 38rpx 46rpx; display: flex; flex-direction: column; gap: 27rpx; }

/* 斜切标签和类型标签 */
.ev-tag { display: inline-block; padding: 8rpx 31rpx; font-size: 23rpx; line-height: 35rpx; font-weight: 700; }
.ev-tag--lime { background: #C2E541; color: #010439; }
.ev-tag--navy { background: #010439; color: #FFFFFF; }
.ev-type { display: flex; align-items: center; box-sizing: border-box; height: 50rpx; padding: 0 19rpx; border: 1px solid #FFFFFF; font-size: 23rpx; }

/* 赛事：照片卡 */
.ev-poster { border-radius: 31rpx; overflow: hidden; border: 1px solid #E6E6E7; }
.ev-poster__top { position: relative; height: 408rpx; background: #010439; color: #FFFFFF; }
.ev-poster__photo { position: absolute; left: 0; top: 0; width: 100%; height: 408rpx; }
.ev-poster__ridge { position: absolute; left: 0; bottom: 0; width: 673rpx; height: 212rpx; }
.ev-poster__tags { position: absolute; left: 31rpx; top: 31rpx; display: flex; align-items: center; gap: 15rpx; }
.ev-poster__text { position: absolute; left: 31rpx; top: 112rpx; display: flex; flex-direction: column; gap: 4rpx; }
.ev-poster__name { font-size: 42rpx; line-height: 58rpx; font-weight: 900; }
.ev-poster__meta { font-size: 25rpx; line-height: 38rpx; color: #E4E7F5; }
.ev-poster__bar { display: flex; align-items: center; justify-content: space-between; height: 131rpx; padding: 0 31rpx; background: #FFFFFF; }
.ev-poster__opens { font-size: 25rpx; line-height: 38rpx; color: #5E6170; }
.ev-remind {
  display: flex; align-items: center; gap: 12rpx;
  height: 85rpx; padding: 0 35rpx; border-radius: 42rpx;
  background: #C2E541; color: #010439; font-size: 27rpx; font-weight: 900;
}
/* 已设提醒：换成灰色时弹一下 */
.ev-remind--done { background: #F5F5F5; color: #5E6170; animation: sxPop .3s ease-out; }
.ev-remind__icon { display: block; width: 35rpx; height: 35rpx; }

/* 订阅新活动通知：一行说明加一个按钮。设计稿里没有，描边同照片卡，按钮同「提醒我」 */
.ev-news { display: flex; align-items: center; gap: 23rpx; padding: 27rpx 31rpx; border-radius: 31rpx; border: 1px solid #E6E6E7; }
.ev-news__text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.ev-news__title { font-size: 29rpx; line-height: 42rpx; font-weight: 900; color: #010439; }
.ev-news__body { font-size: 23rpx; line-height: 35rpx; color: #5E6170; }
.ev-news__btn { flex-shrink: 0; }

/* 加载中的占位块，高度同照片卡和行卡 */
.ev-skeleton { height: 185rpx; border-radius: 31rpx; }
.ev-skeleton--tall { height: 539rpx; }

/* 没有活动时的「敬请期待」：沿用赛事照片卡上半部分的画法（照片、海拔线、标题位置） */
.ev-empty { position: relative; height: 408rpx; border-radius: 31rpx; overflow: hidden; background: #010439; color: #FFFFFF; }
.ev-empty__photo { position: absolute; left: 0; top: 0; width: 100%; height: 408rpx; }
.ev-empty__ridge { position: absolute; left: 0; bottom: 0; width: 673rpx; height: 212rpx; }
.ev-empty__title { position: absolute; left: 31rpx; top: 31rpx; font-size: 42rpx; line-height: 58rpx; font-weight: 900; }

/* 试用装：黄绿卡 */
.ev-lime { position: relative; height: 323rpx; border-radius: 31rpx; overflow: hidden; background: #C2E541; color: #010439; }
.ev-lime__pack { position: absolute; right: 50rpx; top: 27rpx; }
.ev-lime__img { display: block; height: 338rpx; transform: rotate(14deg); }
.ev-lime__text { position: absolute; left: 31rpx; top: 31rpx; width: 423rpx; display: flex; flex-direction: column; align-items: flex-start; gap: 8rpx; }
.ev-lime__name { margin-top: 15rpx; font-size: 38rpx; line-height: 54rpx; font-weight: 900; }
.ev-lime__meta { font-size: 25rpx; line-height: 38rpx; font-weight: 500; }
.ev-lime__btn {
  position: absolute; left: 31rpx; bottom: 31rpx;
  display: flex; align-items: center;
  height: 85rpx; padding: 0 42rpx; border-radius: 42rpx;
  background: #010439; color: #FFFFFF; font-size: 27rpx; font-weight: 700;
}

/* 抽奖：行卡 */
.ev-row { display: flex; align-items: center; gap: 27rpx; height: 185rpx; padding: 0 31rpx; border-radius: 31rpx; background: #F5F5F5; }
.ev-row__icon { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 108rpx; height: 108rpx; border-radius: 54rpx; background: #010439; }
.ev-row__icon-img { display: block; width: 54rpx; height: 54rpx; }
.ev-row__text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.ev-row__type { font-size: 23rpx; line-height: 35rpx; color: #5E6170; }
.ev-row__name { font-size: 33rpx; line-height: 46rpx; font-weight: 900; color: #010439; }
.ev-row__meta { font-size: 25rpx; line-height: 38rpx; color: #5E6170; }
.ev-row__arrow { flex-shrink: 0; display: block; width: 35rpx; height: 35rpx; }

/* 往期：两列照片卡 */
.ev-past { padding: 38rpx 38rpx 46rpx; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 23rpx; }
.ev-past__card { display: flex; flex-direction: column; border-radius: 27rpx; overflow: hidden; background: #010439; color: #FFFFFF; }
.ev-past__img { display: block; width: 100%; height: 238rpx; }
.ev-past__text { display: flex; flex-direction: column; gap: 4rpx; padding: 19rpx 23rpx 27rpx; }
.ev-past__year { font-size: 42rpx; line-height: 44rpx; color: #C2E541; }
.ev-past__name { font-size: 27rpx; line-height: 38rpx; font-weight: 700; }
.ev-past__en { font-size: 21rpx; line-height: 31rpx; color: #C9CEE8; }
