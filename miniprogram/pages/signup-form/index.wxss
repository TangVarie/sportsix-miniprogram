/* 报名表（设计稿里没有）：头部同运营后台的表单页，卡片和按钮同活动详情 */
.sf-page { display: flex; flex-direction: column; box-sizing: border-box; min-height: 100vh; }
.sf-header { position: relative; flex-shrink: 0; height: calc(254rpx + var(--sx-safe-top)); color: #FFFFFF; }
.sf-back {
  position: absolute; left: 23rpx; top: calc(15rpx + var(--sx-safe-top));
  display: flex; align-items: center; height: 85rpx; padding: 0 15rpx;
}
.sf-back__icon { display: block; width: 38rpx; height: 38rpx; }
.sf-header__title { position: absolute; left: 38rpx; right: 38rpx; bottom: 38rpx; display: flex; flex-direction: column; gap: 4rpx; }
.sf-header__h1 { font-size: 58rpx; line-height: 77rpx; font-weight: 900; }
.sf-header__event { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 25rpx; line-height: 38rpx; color: #C9CEE8; }

.sf-body { flex-shrink: 0; padding: 31rpx 38rpx 46rpx; }
.sf-skel { height: 200rpx; margin-top: 23rpx; border-radius: 31rpx; }
.sf-status { display: flex; align-items: center; justify-content: space-between; gap: 23rpx; padding: 23rpx; border-radius: 19rpx; background: #F5F5F5; color: #5E6170; font-size: 25rpx; line-height: 38rpx; }
.sf-status__retry { min-height: 85rpx; display: flex; align-items: center; color: #061A70; font-weight: 700; }

.sf-intro { font-size: 25rpx; line-height: 38rpx; color: #5E6170; }
.sf-card { margin-top: 23rpx; padding: 31rpx; border-radius: 31rpx; background: #F5F5F5; }
.sf-field { margin-bottom: 35rpx; }
.sf-field--last { margin-bottom: 0; }
.sf-label { display: flex; align-items: baseline; gap: 8rpx; font-size: 27rpx; line-height: 40rpx; font-weight: 700; color: #010439; }
.sf-star { color: #061A70; font-weight: 900; }
.sf-hint { display: block; margin-top: 4rpx; font-size: 23rpx; line-height: 35rpx; color: #5E6170; }
.sf-label__hint { margin-left: 8rpx; font-size: 23rpx; font-weight: 400; color: #5E6170; }
.sf-input { box-sizing: border-box; height: 92rpx; margin-top: 12rpx; padding: 0 27rpx; border-radius: 23rpx; border: 2rpx solid #FFFFFF; background: #FFFFFF; font-size: 29rpx; color: #010439; }
.sf-textarea { box-sizing: border-box; width: 100%; height: 220rpx; margin-top: 12rpx; padding: 23rpx 27rpx; border-radius: 23rpx; border: 2rpx solid #FFFFFF; background: #FFFFFF; font-size: 29rpx; line-height: 44rpx; color: #010439; }
/* 没填或格式不对：深蓝描边，和设计里的强调色一致，不另加红色 */
.sf-input--error { border-color: #061A70; }
.sf-ph { color: #9A9CA8; }
.sf-pick { display: flex; align-items: center; }
.sf-pick--empty { color: #9A9CA8; }

.sf-options { display: flex; flex-wrap: wrap; gap: 15rpx; margin-top: 12rpx; }
.sf-option {
  display: flex; align-items: center; justify-content: center; box-sizing: border-box; min-width: 120rpx; height: 77rpx; padding: 0 27rpx;
  border-radius: 19rpx; border: 2rpx solid #FFFFFF; background: #FFFFFF; font-size: 27rpx; font-weight: 700; color: #14141E;
}
.sf-option--on { border-color: #010439; background: #010439; color: #FFFFFF; }
.sf-option--error { border-color: #061A70; }

.sf-agree { display: flex; align-items: flex-start; gap: 15rpx; margin-top: 31rpx; font-size: 23rpx; line-height: 35rpx; color: #5E6170; }
.sf-agree .sx-check { margin-top: 2rpx; }
.sf-agree__box { flex-shrink: 0; width: 31rpx; height: 31rpx; margin-top: 2rpx; box-sizing: border-box; border-radius: 6rpx; border: 2rpx solid #C9CEE8; background: #FFFFFF; }
.sf-agree__text { flex: 1; min-width: 0; }
.sf-agree__link { color: #061A70; font-weight: 700; }

/* 底部操作条：内容短时贴在页面底部，内容长时吸在屏幕底部 */
.sf-bar {
  position: sticky; bottom: 0; flex-shrink: 0; margin-top: auto;
  padding: 23rpx 38rpx calc(46rpx + env(safe-area-inset-bottom));
  border-top: 1px solid #E6E6E7; background: #FFFFFF;
}
.sf-btn { display: flex; align-items: center; justify-content: center; height: 100rpx; border-radius: 50rpx; background: #C2E541; color: #010439; font-size: 31rpx; font-weight: 900; }
.sf-btn--busy { opacity: .5; }
