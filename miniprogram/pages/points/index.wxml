<view class="page" style="--sx-safe-top: {{safeTop}}px">
  <view class="pt-header sx-grid-bg sx-in">
    <view class="pt-back" bindtap="onBack">
      <image class="pt-back__icon" src="/assets/icons/back-white.svg" />
    </view>
    <view class="pt-header__text">
      <text class="sx-eyebrow pt-header__eyebrow">{{copy.eyebrow}}</text>
      <view class="pt-header__title sx-rise">{{copy.title}}</view>
      <view class="pt-header__num sx-num sx-rise" style="animation-delay: .1s">{{points}}</view>
    </view>
  </view>

  <view class="pt-body">
    <view class="pt-note">
      <image class="pt-note__icon" src="/assets/icons/star-navy.svg" />
      <text class="pt-note__text">{{copy.note}}</text>
    </view>

    <view class="pt-h2">{{copy.logTitle}}</view>
    <!-- 等云端返回时的占位块 -->
    <view wx:if="{{loading}}">
      <view wx:for="{{[0, 1]}}" wx:key="*this" class="pt-skel sx-skeleton"></view>
    </view>
    <view wx:elif="{{logs.length}}" class="pt-list">
      <view wx:for="{{logs}}" wx:key="id" class="pt-row {{index > 0 ? 'pt-row--next' : ''}}">
        <view class="pt-row__text">
          <text class="pt-row__reason">{{item.reason}}</text>
          <text wx:if="{{item.date}}" class="pt-row__date">{{item.date}}</text>
        </view>
        <text class="pt-row__delta sx-num {{item.plus ? '' : 'pt-row__delta--minus'}}">{{item.delta}}</text>
      </view>
    </view>
    <view wx:else class="pt-empty">{{copy.empty}}</view>
  </view>
</view>
