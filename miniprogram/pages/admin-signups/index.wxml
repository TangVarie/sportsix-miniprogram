<view class="page" style="--sx-safe-top: {{safeTop}}px">
  <view class="as-header sx-grid-bg">
    <view class="as-back" bindtap="onBack">
      <image class="as-back__icon" src="/assets/icons/back-white.svg" />
    </view>
    <view class="as-header__title">{{copy.title}}</view>
  </view>

  <view class="as-body">
    <view class="as-event">{{title}}</view>
    <view wx:if="{{!loading}}" class="as-count">{{countText}}</view>
    <view wx:if="{{progress}}" class="as-count">{{progress}}</view>
    <view wx:if="{{loadFailed}}" class="as-empty">{{copy.loadFailed}}</view>
    <view wx:if="{{loadFailed}}" class="as-btn as-btn--line" bindtap="onRetry">{{copy.retry}}</view>

    <view wx:if="{{loading}}">
      <view wx:for="{{[0, 1, 2]}}" wx:key="*this" class="as-skel sx-skeleton"></view>
    </view>
    <view wx:elif="{{list.length}}">
      <view class="as-btn as-btn--line sx-pressable" hover-class="sx-press" bindtap="onCopy">{{copy.copy}}</view>
      <view wx:for="{{list}}" wx:key="memberNo" class="as-card">
        <view class="as-card__text">
          <text class="as-card__name">{{item.name}}</text>
          <text class="as-card__meta">{{item.noText}}</text>
          <text class="as-card__meta">{{item.at}}{{item.costText ? ' · ' + item.costText : ''}}</text>
          <view class="as-card__phone" data-phone="{{item.phone}}" bindtap="onCall">
            <text class="as-card__phone-num sx-num" user-select="{{true}}">{{item.phone}}</text>
            <text class="as-card__phone-call">{{copy.call}}</text>
          </view>
        </view>
        <view class="as-mini sx-pressable" hover-class="sx-press" data-no="{{item.memberNo}}" bindtap="onCancel">{{copy.cancel}}</view>
      </view>
    </view>
    <view wx:elif="{{!loadFailed}}" class="as-empty">{{copy.empty}}</view>

    <!-- 取消整场活动：已经取消过、而且名单清空了的不再显示 -->
    <view wx:if="{{loaded && !loading && !loadFailed && !(cancelled && !list.length)}}" class="as-btn as-btn--danger sx-pressable {{busy ? 'as-btn--busy' : ''}}" hover-class="sx-press" bindtap="onCancelEvent">{{copy.cancelEvent}}</view>
  </view>
</view>
