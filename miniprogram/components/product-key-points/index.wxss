/* 数值取自 design/html/03-product-energy-gel.html 的 KEY POINTS 分区 */
:host { display: block; }
.product-kp { display: flex; flex-direction: column; gap: 12rpx; padding: 54rpx 38rpx 8rpx; }
.product-kp__eyebrow { color: #061A70; }
.product-kp__title { font-size: 42rpx; line-height: 58rpx; font-weight: 900; color: #010439; }
.product-kp__list { display: flex; flex-direction: column; gap: 19rpx; margin-top: 19rpx; }
.product-kp__card { display: flex; gap: 23rpx; padding: 31rpx; border-radius: 27rpx; background: #F5F5F5; }
.product-kp__n { flex-shrink: 0; width: 65rpx; padding-top: 2rpx; }
.product-kp__n-text { font-size: 50rpx; line-height: 52rpx; color: #061A70; }
.product-kp__text { display: flex; flex-direction: column; gap: 12rpx; }
.product-kp__name { font-size: 31rpx; line-height: 46rpx; font-weight: 900; color: #010439; }
.product-kp__body { font-size: 25rpx; line-height: 40rpx; color: #14141E; }
