<view class="product-kp {{shown ? 'sx-in' : 'sx-wait'}}">
  <text class="sx-eyebrow product-kp__eyebrow">{{points.eyebrow}}</text>
  <view class="product-kp__title">{{title}}</view>
  <view class="product-kp__list">
    <view wx:for="{{points.items}}" wx:key="n" class="product-kp__card sx-rise" style="animation-delay: {{index * 0.1}}s">
      <view class="product-kp__n"><text class="product-kp__n-text sx-num">{{item.n}}</text></view>
      <view class="product-kp__text">
        <text class="product-kp__name">{{item.title}}</text>
        <text class="product-kp__body">{{item.body}}</text>
      </view>
    </view>
  </view>
</view>
