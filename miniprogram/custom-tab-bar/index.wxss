/* 设计稿：高 64px，上边 1px 分割线；「补给」直径 48px、上凸 18px、3px 白描边。真机加底部安全区。 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  height: 123rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1px solid #E6E6E7;
  background: #FFFFFF;
}
.tabbar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #5E6170;
  font-size: 21rpx;
  line-height: 27rpx;
  font-weight: 400;
}
.tabbar__item--on { color: #061A70; font-weight: 700; }
.tabbar__item--raised { justify-content: flex-end; gap: 4rpx; padding-bottom: 17rpx; }
.tabbar__icon { display: block; width: 46rpx; height: 46rpx; }
.tabbar__raised {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 92rpx;
  height: 92rpx;
  margin-top: -35rpx;
  border-radius: 46rpx;
  border: 6rpx solid #FFFFFF;
  background: #C2E541;
}
